# Local destructive E2E scenario configuration.
# Copy to tests/e2e/e2e.env and edit before running make e2e-* targets.
# Never use real personal media. Use disposable test media only.
# E2E tests execute packaged tools from dist/suf/bin only.
# Run `make package` first.

SUF_E2E_TOOL_DIR=dist/suf/bin
SUF_E2E_DEVICE_PATH=/dev/disk/by-id/REPLACE_ME
SUF_E2E_STICK_ID=green
SUF_E2E_MEDIA_MOUNT=/media/green-stick
SUF_E2E_STICK_PASSPHRASE=REPLACE_ME
SUF_E2E_VAULT=test1
SUF_E2E_VAULT_SIZE=64M
SUF_E2E_VAULT_PURPOSE=test vault
SUF_E2E_VAULT_PASSPHRASE=REPLACE_ME

# Existing mounted media scenario. Example: VeraCrypt-mounted volume.
# This scenario only creates/mounts/wipes a vault inside this mount.
# It does not create, unmount, or wipe the outer media.
SUF_E2E_EXTERNAL_MOUNT=REPLACE_ME

SUF_E2E_TIMEOUT=300
SUF_E2E_HEARTBEAT=15
